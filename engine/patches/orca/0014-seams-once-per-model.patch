+// cloud-slicer: whether two objects' seam visibility (compute_global_occlusion)
+// comes out the same: same seam position, same parts and negative parts with
+// the same meshes in the same places, turned and scaled alike. Copies of one
+// model, even with settings of their own (another filament, other infill),
+// are; their visibility is then worked out once.
+static bool same_seam_visibility(const PrintObject *a, const PrintObject *b) {
+  if (a->config().seam_position.value != b->config().seam_position.value) return false;
+  if (!(a->trafo_sliced().matrix() == b->trafo_sliced().matrix())) return false;
+  auto parts = [](const PrintObject *po) {
+    std::vector<const ModelVolume*> out;
+    for (const ModelVolume *v : po->model_object()->volumes)
+      if (v->type() == ModelVolumeType::MODEL_PART || v->type() == ModelVolumeType::NEGATIVE_VOLUME) out.push_back(v);
+    return out;
+  };
+  const std::vector<const ModelVolume*> pa = parts(a), pb = parts(b);
+  if (pa.size() != pb.size()) return false;
+  for (size_t i = 0; i < pa.size(); ++i) {
+    const ModelVolume &va = *pa[i], &vb = *pb[i];
+    if (va.type() != vb.type() || !(va.get_matrix().matrix() == vb.get_matrix().matrix())) return false;
+    if (&va.mesh() != &vb.mesh()
+        && (va.mesh().its.vertices != vb.mesh().its.vertices || va.mesh().its.indices != vb.mesh().its.indices))
+      return false;
+  }
+  return true;
+}
