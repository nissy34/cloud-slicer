Invalidation: support and slicing redo the lift detection.

PrintObject::detect_overhangs_for_lift fills each layer's loverhangs after
support generation, and support generation (its overhang detection, also run
to check whether supports are needed) clears them. Invalidating
posSupportMaterial (a speed, a brim, a move) left posDetectOverhangsForLift
done, so a Print sliced again (desktop does after such a change; the browser
engine keeps the last slice's Print) lost every overhang and lifted
differently from a fresh slice. A new layer height (posSlice) left it done
on new layers too. Both now invalidate it.

diff --git a/src/libslic3r/PrintObject.cpp b/src/libslic3r/PrintObject.cpp
index acb4670..e5dc136 100644
--- a/src/libslic3r/PrintObject.cpp
+++ b/src/libslic3r/PrintObject.cpp
@@ -1291,12 +1291,14 @@ bool PrintObject::invalidate_step(PrintObjectStep step)
         invalidated |= this->invalidate_steps({ posIroning, posSimplifyInfill });
         invalidated |= m_print->invalidate_steps({ psSkirtBrim });
     } else if (step == posSlice) {
-		invalidated |= this->invalidate_steps({ posPerimeters, posPrepareInfill, posInfill, posIroning, posSupportMaterial, posSimplifyPath, posSimplifyInfill });
+		invalidated |= this->invalidate_steps({ posPerimeters, posPrepareInfill, posInfill, posIroning, posSupportMaterial, posSimplifyPath, posSimplifyInfill, posDetectOverhangsForLift });
         invalidated |= m_print->invalidate_steps({ psSkirtBrim });
         m_slicing_params.valid = false;
         this->clear_local_z_plan();
     } else if (step == posSupportMaterial) {
-        invalidated |= this->invalidate_steps({ posSimplifySupportPath });
+        // cloud-slicer: support generation clears each layer's overhangs, which
+        // the lift detection fills in after it, so it has to run again too.
+        invalidated |= this->invalidate_steps({ posSimplifySupportPath, posDetectOverhangsForLift });
         invalidated |= m_print->invalidate_steps({ psSkirtBrim });
         m_slicing_params.valid = false;
     }
