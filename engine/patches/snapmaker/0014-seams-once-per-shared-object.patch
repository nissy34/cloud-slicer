   for (const PrintObject *po : print.objects()) {
     throw_if_canceled_func();
+    // cloud-slicer: an object identical to an earlier one (Print::process's
+    // shared object, e.g. a clone) prints that object's own layers, and
+    // place_seam looks seams up by layer->object(), so the seams it uses are
