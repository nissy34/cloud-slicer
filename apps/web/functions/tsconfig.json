{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // vite/client: some shared src/lib files the functions import types from use import.meta.glob (src/i18n).
    "types": ["vite/client"]
  },
  "include": ["**/*.ts"]
}
