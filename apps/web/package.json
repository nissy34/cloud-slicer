{
  "name": "@cloud-slicer/web",
  "private": true,
  "type": "module",
  "scripts": {
    "engine": "node scripts/copy-engine.mjs",
    "engine:fetch": "node ../../engine/scripts/fetch-engine.mjs",
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p functions",
    "smoke": "node test/smoke.mjs",
    "pages": "wrangler d1 migrations apply cloud-slicer --local && wrangler pages dev dist",
    "test:accounts": "node test/accounts.mjs",
    "test:presets": "node test/presets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "better-auth": "1.7.7",
    "culori": "4.0.2",
    "fflate": "0.8.2",
    "idb-keyval": "6.3.0",
    "jose": "6.2.12",
    "lucide-react": "1.54.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1",
    "three-mesh-bvh": "0.7.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@expo-google-fonts/frank-ruhl-libre": "0.4.1",
    "@expo-google-fonts/heebo": "0.4.2",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-hebrew": "0.4.1",
    "@expo-google-fonts/noto-sans-mono": "0.4.2",
    "@expo-google-fonts/noto-serif": "0.4.2",
    "@expo-google-fonts/rubik": "0.4.2",
    "@types/culori": "^4.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.56.1",
    "postcss": "^8.5.30",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7",
    "wrangler": "4.151.1",
    "ws": "^8.18.3"
  }
