/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Revalidate (cheap 304s) so a new deploy's engine is picked up at once.
/engine/*
  Cache-Control: no-cache

# The service worker must update as soon as a deploy changes it.
/sw.js
  Cache-Control: no-cache

# Open from Google Drive: Google's file window runs in this page, which must not
# be cross-origin isolated (that blocks Google's frames). It holds no engine.
/drive-picker
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
  ! Cross-Origin-Resource-Policy
/drive-picker.html
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
  ! Cross-Origin-Resource-Policy
